<div class="wb-body">
  <header class="wb-header">
    <div class="wb-identity">
      <span class="wb-eyebrow wb-archive-title">Worlds Beyond <span aria-hidden="true">✦</span> Infinite Archive</span>
      <input class="wb-name" type="text" name="name" value="{{actor.name}}" placeholder="Name" {{#unless editable}}disabled{{/unless}}>
      <div class="wb-identity-tags">
        <button type="button" data-action="viewTab" data-tab="notes" title="Race and character notes"><i class="fa-solid fa-fingerprint" aria-hidden="true"></i> {{overviewRace}}</button><span aria-hidden="true">·</span>
        {{#if canRenameBaseForm}}
        <button type="button" data-action="archiveAppearance" title="Rename base form" aria-label="Rename {{baseFormName}}"><i class="fa-solid fa-moon" aria-hidden="true"></i> {{overviewForm}} <i class="fa-solid fa-pen" aria-hidden="true"></i></button>
        {{else}}
        <button type="button" data-action="viewTab" data-tab="abilities" title="Abilities and forms"><i class="fa-solid fa-moon" aria-hidden="true"></i> {{overviewForm}}</button>
        {{/if}}
      </div>
    </div>
    <label class="wb-level">
      <span class="wb-eyebrow">Level</span>
      <input type="number" name="system.level" value="{{system.level}}" min="1" step="1" {{#unless editable}}disabled{{/unless}}>
    </label>
  </header>

  <nav class="tabs wb-sheet-tabs" aria-label="Character sheet sections">
    {{#each tabs}}
    <button type="button" class="{{cssClass}}" data-action="tab" data-group="{{group}}" data-tab="{{id}}" aria-pressed="{{active}}">{{label}}</button>
    {{/each}}
  </nav>
  <section class="tab wb-sheet-panel {{tabs.character.cssClass}}" data-group="sheet" data-tab="character" aria-label="Character">
    <div class="wb-frontispiece">
      <section class="wb-astral-portrait" aria-label="Character artwork and eight attributes">
        <div class="wb-orbit-toolbar"><span class="wb-eyebrow">Attributes</span><div><button type="button" data-action="archiveAppearance" title="Portrait framing and Base form name" aria-label="Portrait framing and Base form name" {{#unless editable}}disabled{{/unless}}><i class="fa-solid fa-sliders" aria-hidden="true"></i></button><button type="button" data-action="milestones" title="Milestone rules" aria-label="Milestone rules"><i class="fa-solid fa-diamond" aria-hidden="true"></i></button><button type="button" data-action="overviewEdit" data-field="statScores.str" title="Edit attributes" aria-label="Edit attributes"><i class="fa-solid fa-pen" aria-hidden="true"></i></button></div></div>
        <div class="wb-attribute-orbit">
          <div class="wb-singularity" aria-hidden="true">
            <span class="wb-vortex-nebula"></span>
            <img class="wb-vortex-streams" src="systems/worlds-beyond/icons/void-vortex.svg" alt="">
            <span class="wb-vortex-texture"></span>
            <span class="wb-vortex-depth"></span>
          </div>
          <div class="wb-orbit-art" style="--wb-portrait-y:{{overviewPortraitY}}%"><button type="button" data-action="pickPortrait" title="Change artwork for the current form" aria-label="Change artwork for the current form" {{#unless editable}}disabled{{/unless}}><img src="{{actor.img}}" alt="{{actor.name}}"></button></div>
          {{#each overviewStats}}<button type="button" class="wb-stat-orb wb-orb-{{key}} {{#if manual}}is-manual{{/if}} {{#if adjusted}}is-adjusted{{/if}}" data-action="rollStat" data-stat="{{key}}" title="{{label}} {{value}} · {{modLabel}} · Check or save{{#if sources}} · {{sources}}{{/if}}" aria-label="{{label}} {{value}}, modifier {{modLabel}}. Roll a check or save." {{#unless @root.editable}}disabled{{/unless}}>
            <span class="wb-orb-abbr">{{abbr}}</span><span class="wb-orb-scoreline"><span class="wb-orb-pip {{#if pips.0.lit}}is-lit{{/if}}" title="21: {{pips.0.name}} · {{pips.0.status}}" aria-hidden="true"></span><strong class="wb-orb-value">{{value}}</strong><span class="wb-orb-pip {{#if pips.1.lit}}is-lit{{/if}}" title="28: {{pips.1.name}} · {{pips.1.status}}" aria-hidden="true"></span></span><span class="wb-orb-mod">{{modLabel}}</span>
          </button>{{/each}}
        </div>
        <div class="wb-portrait-caption"><span class="wb-caption-rule"></span><span>Hit die <strong>{{system.core.hitDie}}</strong></span><span class="wb-caption-rule"></span></div>
      </section>
      <section class="wb-overview-vitals" aria-label="Health, resources and combat values">
        <button type="button" class="wb-overview-health {{#if overviewHealth.low}}is-low{{/if}} {{#if overviewHealth.overflow}}is-overflow{{/if}}" data-action="overviewEdit" data-field="healthCurrent" title="Edit Health">
          <span class="wb-overview-card-heading"><span class="wb-eyebrow">Health</span><i class="fa-regular fa-heart" aria-hidden="true"></i></span>
          <span class="wb-overview-number">{{overviewHealth.value}} <small>/ {{overviewHealth.max}}</small></span>
          <span class="wb-overview-meter" role="progressbar" aria-label="Health" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{overviewHealth.meter}}" aria-valuetext="{{overviewHealth.value}} / {{overviewHealth.max}} Health"><span style="width:{{overviewHealth.meter}}%;{{overviewHealth.barStyle}}"></span></span>
        </button>
        <div class="wb-overview-economy">{{#each overviewEconomy}}<button type="button" data-action="overviewEdit" data-field="{{field}}" title="Edit {{label}}" class="wb-economy-tile {{#if overflow}}is-overflow{{/if}}"><span class="wb-eyebrow">{{label}}</span><strong>{{value}}<small>/{{max}}</small></strong><span class="wb-overview-meter wb-segmented-meter" style="--wb-segments:{{segments}}" role="progressbar" aria-label="{{label}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{meter}}" aria-valuetext="{{value}} / {{max}}"><span style="width:{{meter}}%;{{barStyle}}"></span></span>{{#if command}}<span class="wb-command-pool">Includes {{command}} Command</span>{{/if}}</button>{{/each}}</div>
        <div class="wb-overview-pools">{{#each overviewPools}}<button type="button" class="wb-overview-pool {{#if overflow}}is-overflow{{/if}}" data-action="overviewEdit" data-field="resourceValues.{{key}}" title="Edit {{label}} · {{value}} / {{max}} points">
          <span class="wb-overview-pool-top"><span class="wb-eyebrow">{{label}}</span><strong>{{#if percentUnavailable}}—%{{else}}{{#if percent}}{{inputValue}}%{{else}}{{value}}<small>/{{max}}</small>{{/if}}{{/if}}</strong></span>
          <span class="wb-overview-meter" role="progressbar" aria-label="{{label}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{meterPercent}}" aria-valuetext="{{value}} points; maximum {{max}}"><span style="width:{{meterPercent}}%;{{barStyle}}"></span></span>{{#if overflow}}<small class="wb-overflow-note">Above maximum</small>{{/if}}
        </button>{{/each}}</div>
        <div class="wb-overview-metrics">
          <button type="button" data-action="overviewEdit" title="Armor and evasion details"><span class="wb-eyebrow">Natural Evasion</span><strong>{{system.core.evasion}}</strong></button>
          <button type="button" data-action="overviewEdit" title="Armor and defense details"><span class="wb-eyebrow">Armor Rating</span><strong>{{system.core.armorRating}}</strong></button>
          <button type="button" data-action="overviewEdit" title="Movement details"><span class="wb-eyebrow">Movement / AP</span><strong>{{system.core.movement}} <small>ft</small></strong></button>
          <div><span class="wb-eyebrow">Initiative</span><strong>{{overviewInitiative}}</strong><small>1d20 + WIS</small></div>
        </div>
      </section>
    </div>
    <div class="wb-archive-convergence" aria-hidden="true"><span></span><b>✦</b><span></span></div>
    <section class="wb-archive-foundation" aria-label="Favorite abilities and character utilities"><section class="wb-favorites" aria-label="Four favorite abilities">
      <div class="wb-section-heading"><h2 class="wb-section-title">Favorite abilities <small>Inscribed in the Archive</small></h2><button type="button" data-action="favorites" title="Choose four favorite abilities" {{#unless editable}}disabled{{/unless}}><i class="fa-regular fa-star" aria-hidden="true"></i> Choose</button></div>
      <div class="wb-favorite-grid">{{#each favoriteSlots}}
        <article class="wb-favorite-card {{#if empty}}is-empty{{/if}} {{#if effectsActive}}is-active{{/if}}" {{#unless empty}}data-ability-id="{{id}}" {{#if legacy}}data-effect-uuid="{{uuid}}"{{/if}}{{/unless}}><span class="wb-inscription-seal" aria-hidden="true">{{index}}</span>
          {{#if empty}}<button type="button" class="wb-favorite-empty" data-action="favorites" {{#unless @root.editable}}disabled{{/unless}}><span class="wb-favorite-index">0{{index}}</span><span>{{name}}</span><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
          {{else}}<button type="button" class="wb-favorite-name" data-action="{{#if legacy}}savedAbility{{else}}ability{{/if}}" data-operation="edit" title="{{name}} · {{summary}}"><img src="{{img}}" alt="" loading="lazy"><strong>{{name}}</strong></button><small class="wb-favorite-summary" title="{{summary}}">{{quickSummary}}</small><button type="button" class="wb-favorite-use {{#if effectsActive}}is-active{{/if}}" data-action="{{#if legacy}}savedAbility{{else}}ability{{/if}}" data-operation="{{operation}}" aria-label="{{actionLabel}} {{name}}" {{#unless @root.editable}}disabled{{/unless}}>{{actionLabel}}</button>{{/if}}
        </article>
      {{/each}}</div>
    </section>
    <footer class="wb-overview-footer"><button type="button" class="wb-overview-status" data-action="viewTab" data-tab="status" title="View active Status"><i class="fa-solid fa-circle-nodes" aria-hidden="true"></i><span>{{#if overviewStatusCount}}{{overviewStatus}}{{else}}No active status{{/if}}</span>{{#if overviewStatusCount}}<small>{{overviewStatusCount}}</small>{{/if}}</button><div><button type="button" data-action="command" {{#unless editable}}disabled{{/unless}}>Command</button><button type="button" data-action="longRest" {{#unless editable}}disabled{{/unless}}>Long rest</button></div></footer></section>
  </section>
  <section class="tab wb-sheet-panel {{tabs.details.cssClass}}" data-group="sheet" data-tab="details" data-record-tab aria-label="Character controls and detailed values">
  <header class="wb-record-heading"><div><span class="wb-eyebrow">The character ledger</span><h2>Details</h2></div><span class="wb-record-seal" aria-hidden="true"><i class="fa-solid fa-sliders"></i></span></header>
  <section class="wb-resources" aria-label="Resources">
    {{#each resources as |resource|}}
    <div class="wb-resource wb-resource-{{resource.key}}">
      <label class="wb-resource-label">
        <span class="wb-eyebrow">{{resource.label}}</span>
        <span class="wb-resource-values" {{#if resource.sources}}data-tooltip="{{resource.sources}} · Final maximum overrides still take priority"{{/if}}>
          <input type="number" name="{{resource.inputName}}" value="{{resource.value}}" step="1" aria-label="Current {{resource.label}}" {{#unless @root.editable}}disabled{{/unless}}>
          <span class="wb-resource-max" aria-label="Maximum {{resource.label}}">/ {{resource.max}}</span>
        </span>
        {{#if resource.command}}<small class="wb-command-pool" data-tooltip="Included in the total above, not added twice. Command AP spends first on your turn; the maximum shown is your normal AP cap.">Includes {{resource.command}} Command AP{{#if resource.commandPending}} · your turn{{/if}}</small>{{/if}}
      </label>
    </div>
    {{/each}}
  </section>

  <div class="wb-wonder-rest">
    <button type="button" data-action="command" data-tooltip="Spend 5 own AP to give an ally up to 5 Command AP" {{#unless editable}}disabled{{/unless}}>Command</button>
    <button type="button" data-action="longRest" data-tooltip="Restore all resources to maximum" {{#unless editable}}disabled{{/unless}}>Long rest</button>
  </div>

  <details class="wb-disclosure wb-core-bar-colors" data-sync="core-bar-colors"><summary>Core bar colors</summary>
    <div class="wb-core-color-grid">{{#each resources}}<fieldset><legend>{{label}}</legend><div class="wb-bar-color-fields">
      <label>Color (hex)<input type="text" name="system.{{key}}.barColors.start" value="{{barColors.start}}" placeholder="Theme default" maxlength="7" pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})" title="Hex color such as #6FD6FF or #ABC. Clear for the default." autocomplete="off" spellcheck="false" {{#unless @root.editable}}disabled{{/unless}}></label>
      <label>Gradient end (optional)<input type="text" name="system.{{key}}.barColors.end" value="{{barColors.end}}" placeholder="Solid color" maxlength="7" pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})" title="A second hex color blends left to right with the first." autocomplete="off" spellcheck="false" {{#unless @root.editable}}disabled{{/unless}}></label>
    </div></fieldset>{{/each}}</div>
  </details>

  <section class="wb-extra-resources" aria-label="Magic and custom resources">
    <div class="wb-section-heading">
      <h2 class="wb-section-title">Resources</h2>
      {{#if hasHiddenFormResources}}<button type="button" data-action="formView" data-view="resources" aria-pressed="{{showAllFormResources}}">{{#if showAllFormResources}}Form resources{{else}}Show all{{/if}}</button>{{/if}}
      <details class="wb-resource-management wb-disclosure" data-sync="resource-management"><summary>Manage</summary>
        <div class="wb-resource-management-fields">
          <label class="wb-equipment-check"><input type="checkbox" name="system.mana.enabled" {{#if manaEnabled}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> Show mana</label>
          <label class="wb-equipment-check"><input type="checkbox" name="system.holyPower.enabled" {{#if holyPowerEnabled}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> Show holy power</label>
          <button type="button" data-action="resource" data-operation="add" {{#unless editable}}disabled{{/unless}}>Add resource</button>
        </div>
      </details>
    </div>
    <div class="wb-extra-resource-grid">
      {{#each resourcePools}}
      <article class="wb-pool-card wb-pool-{{#if custom}}custom{{else}}{{key}}{{/if}}" data-resource-key="{{key}}">
        <header class="wb-pool-heading"><h3>{{label}}</h3>
          {{#if custom}}<button type="button" class="wb-item-remove" data-action="resource" data-operation="remove" aria-label="Remove {{label}}" data-tooltip="Remove resource" {{#unless @root.editable}}disabled{{/unless}}><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>{{/if}}
        </header>
        <div class="wb-resource-values {{#if percent}}wb-percent-values{{/if}}" data-tooltip="{{value}} / {{max}} points · Minimum {{min}}{{#if sources}} · {{sources}} · Final maximum overrides still take priority{{/if}}">
          {{#if percentUnavailable}}<strong class="wb-percent-unavailable">—%</strong>
          {{else}}<input type="number" name="resourceValues.{{key}}" value="{{inputValue}}" step="1" aria-label="Current {{label}}{{#if percent}} percentage{{/if}}" {{#unless @root.editable}}disabled{{/unless}}><span class="wb-resource-max">{{#if percent}}%{{else}}/ {{max}}{{/if}}</span>{{/if}}
        </div>
        <div class="wb-pool-meter" role="progressbar" aria-label="{{label}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{meterPercent}}" aria-valuetext="{{value}} points; minimum {{min}}, maximum {{max}}"><span style="width: {{meterPercent}}%;{{barStyle}}"></span></div>
        <div class="wb-pool-actions">
          <input type="number" name="{{path}}.amount" value="{{amount}}" min="0" step="1" data-resource-amount aria-label="Points to spend or restore for {{label}}" data-tooltip="Points to spend or restore" {{#unless @root.editable}}disabled{{/unless}}>
          <button type="button" data-action="resource" data-operation="spend" {{#unless @root.editable}}disabled{{/unless}}>Spend</button>
          <button type="button" data-action="resource" data-operation="restore" {{#unless @root.editable}}disabled{{/unless}}>Restore</button>
          <button type="button" data-action="resource" data-operation="fill" {{#unless @root.editable}}disabled{{/unless}}>Fill</button>
        </div>
        {{#if regen}}<button type="button" class="wb-pool-recover" data-action="resource" data-operation="recover" data-tooltip="Apply this pool's configured recovery once" {{#unless @root.editable}}disabled{{/unless}}>Recover +{{regen}}</button>{{/if}}
        {{#if autoRecover}}{{#if regen}}<small class="wb-status-time">+{{regen}} on your turn</small>{{/if}}{{/if}}
        <details class="wb-disclosure wb-pool-settings" data-sync="pool-{{key}}"><summary>Settings</summary>
          <div class="wb-pool-settings-grid">
            {{#if custom}}
              <label>Name<input type="text" name="{{path}}.name" value="{{name}}" {{#unless @root.editable}}disabled{{/unless}}></label>
              <label data-tooltip="Selected stat × (level + 2)">Maximum from<select name="{{path}}.scaleStat" {{#unless @root.editable}}disabled{{/unless}}>{{#each scalingChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            {{/if}}
            <label>Recovery amount (points)<input type="number" name="{{path}}.regen" value="{{regen}}" min="0" step="1" {{#unless @root.editable}}disabled{{/unless}}></label>
            <label class="wb-equipment-check" data-tooltip="Apply Recovery amount once at the start of this character's turn in a started encounter; the active GM performs it"><input type="checkbox" name="{{path}}.autoRecover" {{#if autoRecover}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}> Recover on own turn</label>
            <label class="wb-equipment-check"><input type="checkbox" name="{{path}}.refillOnRest" {{#if refillOnRest}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}> Fill on long rest</label>
            <label data-tooltip="Replaces the calculated maximum and bonuses. Clear to restore the selected maximum source.">Maximum override<input type="number" name="{{path}}.maxOverride" value="{{maxOverride}}" placeholder="Default {{automatic}}" min="0" step="1" {{#unless @root.editable}}disabled{{/unless}}></label>
            <label data-tooltip="Empty bar and spending floor. Clear to use 0; negative values are allowed.">Minimum override<input type="number" name="{{path}}.minOverride" value="{{minOverride}}" placeholder="Default 0" step="1" {{#unless @root.editable}}disabled{{/unless}}></label>
            <label class="wb-equipment-check" data-tooltip="Restore and consumables can raise Current above the normal maximum. Fill still returns to the maximum."><input type="checkbox" name="{{path}}.allowOverflow" {{#if allowOverflow}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}> Allow over maximum</label>
            <label>Display<select name="{{path}}.display" {{#unless @root.editable}}disabled{{/unless}}>{{#each displayChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label>Color (hex)<input type="text" name="{{path}}.barColors.start" value="{{barColors.start}}" placeholder="Theme default" maxlength="7" pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})" title="Hex color such as #6FD6FF or #ABC. Clear for the default." autocomplete="off" spellcheck="false" {{#unless @root.editable}}disabled{{/unless}}></label>
            <label>Gradient end (optional)<input type="text" name="{{path}}.barColors.end" value="{{barColors.end}}" placeholder="Solid color" maxlength="7" pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})" title="A second hex color blends left to right with the first." autocomplete="off" spellcheck="false" {{#unless @root.editable}}disabled{{/unless}}></label>
            {{#if percentUnavailable}}<label data-tooltip="Percentage needs a maximum greater than minimum; edit points here">Current points<input type="number" name="resourceValues.{{key}}" value="{{value}}" step="1" {{#unless @root.editable}}disabled{{/unless}}></label>{{/if}}
          </div>
        </details>
      </article>
      {{/each}}
    </div>
  </section>

  <section class="wb-core" aria-label="Core numbers">
    {{#each coreDetails as |detail|}}
    <div class="wb-core-detail">
      <span class="wb-eyebrow">{{detail.label}}</span>
      <strong class="wb-core-value" {{#if detail.sources}}data-tooltip="{{detail.sources}} · Final overrides still take priority"{{/if}}>{{detail.value}} <small>{{detail.unit}}</small></strong>
    </div>
    {{/each}}
  </section>

  <section class="wb-defenses" aria-label="Defenses">
    <h2 class="wb-section-title">Defenses <span>1 reaction</span></h2>
    <div class="wb-defense-actions">
      <button type="button" class="wb-block-action" data-action="block" data-tooltip="Reduce incoming damage" {{#unless editable}}disabled{{/unless}}>Block <small>{{block.formula}} {{block.strMod}}</small></button>
      <button type="button" class="wb-dodge-action" data-action="dodge" data-tooltip="Avoid an attack or make an area save" {{#unless editable}}disabled{{/unless}}>Dodge <small>d20 {{dodgeMod}}</small></button>
      <button type="button" class="wb-parry-action" data-action="parry" data-tooltip="DEX 21 · once per round" {{#unless editable}}disabled{{/unless}}>Parry <small>d20 {{parryMod}}</small></button>
    </div>
    {{#if worn.heavyDisadvantage}}<p class="wb-warning">Heavy armor: attacks, Dodge and AGL saves have disadvantage.</p>{{/if}}
    {{#each worn.duplicatePieces}}<p class="wb-warning">Multiple {{this}} equipped · review contributions.</p>{{/each}}
  </section>

  <div class="wb-section-heading wb-stat-heading">
    <h2 class="wb-section-title">Attributes</h2>
    <div class="wb-stat-tools">
      <button type="button" data-action="milestones" data-tooltip="Milestone rules and current unlocks">Milestones</button>
      <button type="button" data-action="statSetup" data-mode="generation" data-tooltip="Roll 2d6 + 1d12 or type scores, then assign them" {{#unless editable}}disabled{{/unless}}>Roll &amp; assign</button>
      <button type="button" data-action="statSetup" data-mode="advancement" data-tooltip="4 points at levels 4, 8, 12, 16 and 19; at most 2 in one stat per award" {{#unless editable}}disabled{{/unless}}>Stat points{{#if unspentStatPoints}} <span class="wb-badge">{{unspentStatPoints}} left</span>{{/if}}</button>
    </div>
  </div>
  <section class="wb-stats">
    {{#each groups as |group|}}
    <div class="wb-group">
      <h2 class="wb-group-title">{{group.title}}</h2>
      <ol class="wb-stat-list">
        {{#each group.rows as |stat|}}
        <li class="wb-stat">
          <button type="button" class="wb-abbr" data-action="rollStat" data-stat="{{stat.key}}" data-tooltip="{{stat.label}} check or save: choose normal, advantage or disadvantage">{{stat.abbr}}</button>
          <span class="wb-label">{{stat.label}}</span>
          <input class="wb-score {{#if stat.manual}}is-manual{{/if}} {{#if stat.adjusted}}is-adjusted{{/if}}" type="number" name="statScores.{{stat.key}}" data-stat-score="{{stat.key}}" data-base="{{stat.baseValue}}" data-default="{{stat.defaultValue}}" data-effective="{{stat.value}}" data-manual="{{stat.manual}}" data-adjusted="{{stat.adjusted}}" value="{{stat.value}}" step="1" aria-label="{{stat.label}} score; edit base score" data-tooltip="{{stat.label}}: {{stat.value}}. Select to edit your base score. Clear to reset the manual edit; effects still apply.{{#if stat.sources}} {{stat.sources}}{{/if}}" {{#unless @root.editable}}disabled{{/unless}}>
          <span class="wb-mod {{#if stat.negative}}is-negative{{/if}}" aria-label="{{stat.label}} modifier">{{stat.modLabel}}</span>
          <span class="wb-pips">
            {{#each stat.pips as |pip|}}
            <button type="button" class="wb-milestone-button" data-action="milestones" data-stat="{{stat.key}}" data-threshold="{{pip.score}}" aria-label="{{pip.name}}, {{stat.abbr}} {{pip.score}}: {{pip.status}}. View rules." data-tooltip="{{pip.score}}: {{pip.name}} · {{pip.status}} · {{pip.summary}}"><span class="wb-pip {{#if pip.lit}}is-lit{{/if}}" aria-hidden="true"></span></button>
            {{/each}}
          </span>
        </li>
        {{/each}}
      </ol>
    </div>
    {{/each}}
  </section>

  <details class="wb-disclosure wb-adjustments" data-sync="adjustments">
    <summary>Adjust values{{#if hasAdjustments}} <span class="wb-badge">Custom</span>{{/if}}</summary>
    <div class="wb-adjust-grid">
      {{#each resources as |resource|}}
      <label class="wb-override-label"><span>{{resource.label}} maximum</span><input type="number" name="system.{{resource.key}}.maxOverride" value="{{resource.maxOverride}}" placeholder="Auto" step="1" aria-label="{{resource.label}} maximum override; clear for automatic" {{#unless @root.editable}}disabled{{/unless}}></label>
      {{/each}}
      {{#each coreDetails as |detail|}}
      <label class="wb-override-label"><span>{{detail.label}}</span><input type="{{detail.type}}" name="system.overrides.{{detail.key}}" value="{{detail.override}}" placeholder="Auto {{detail.automatic}}" step="1" aria-label="{{detail.label}} override; clear for automatic" {{#unless @root.editable}}disabled{{/unless}}></label>
      {{/each}}
      <label class="wb-override-label"><span>Extra Armor Rating</span><input type="number" name="system.bonuses.armor" value="{{system.bonuses.armor}}" step="1" {{#unless editable}}disabled{{/unless}}></label>
      <label class="wb-equipment-check" data-tooltip="Healing consumables may raise Health above its normal maximum."><input type="checkbox" name="system.health.allowOverflow" {{#if system.health.allowOverflow}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> Allow Health over maximum</label>
      <label class="wb-override-label"><span>Command AP correction</span><input type="number" name="system.command.value" value="{{commandPool.value}}" step="1" {{#unless editable}}disabled{{/unless}}></label>
      <label class="wb-override-label"><span>Extra Evasion</span><input type="number" name="system.bonuses.evasion" value="{{system.bonuses.evasion}}" step="1" {{#unless editable}}disabled{{/unless}}></label>
      <label class="wb-override-label"><span>Extra movement / AP (ft)</span><input type="number" name="system.bonuses.movement" value="{{system.bonuses.movement}}" step="1" {{#unless editable}}disabled{{/unless}}></label>
      <label class="wb-override-label"><span>Armor AGL penalty</span><input type="number" name="system.overrides.armorAgilityPenalty" value="{{system.overrides.armorAgilityPenalty}}" placeholder="{{worn.automaticPenalty}}" step="1" {{#unless editable}}disabled{{/unless}}></label>
      <label class="wb-override-label"><span>Inventory slots</span><input type="number" name="system.overrides.inventorySlots" value="{{system.overrides.inventorySlots}}" placeholder="Auto {{carrying.automatic}}" step="1" aria-label="Inventory slots override; clear for automatic" {{#unless editable}}disabled{{/unless}}></label>
    </div>
    <p>Clear an override to use the automatic value. Extra AR and Evasion add to equipped items; final overrides replace the total.</p>
  </details>
  <details class="wb-disclosure wb-help" data-sync="sheet-help"><summary>Rules &amp; help</summary>
    <h3>Stats &amp; resources</h3>
    <p>Click a stat abbreviation for a check or save. Diamonds mark 21 and 28. A stat shows its effective score; select it to edit the base, including earned stat points. Level-up points keep the normal base color. Gear or effects use teal, manual edits gold, and both together purple. Clear a manual edit to restore its remembered base; earned points and active effects still apply.</p>
    <p>{{#if defyFate}}Defy Fate declares a failed check or save successful. Initiative still rerolls.{{else}}Wonder rerolls a non-attack d20. Uses equal your FTH modifier.{{/if}} Use Wonder from a roll's chat card. Each result may use Wonder once; its new result replaces it and may use Wonder again. Long rest refills Health, AP, reactions, Wonder, mana and holy power, plus custom pools set to refill.</p>
    <p>Show mana or holy power under Resources → Manage. Their maxima use current INT or FTH × (level + 2). Custom resources can use any stat or a manual maximum. Settings → Maximum override sets the final cap; clearing it restores the selected source. Current totals follow maximum changes while preserving points spent. Clearing Current fills the pool. Recovery is manual, and hiding a magic pool preserves its balance.</p>
    <p>Minimum override sets the empty bar and spending floor (normally 0); a negative minimum allows spending below zero. Manual Current corrections remain unrestricted. Percentage display runs from minimum (0%) to maximum (100%); action amounts always mean points. Entries and visible totals round down to whole numbers; fractional calculations stay in the background. Hover over the total for whole points and minimum. If maximum is not greater than minimum, percentage is unavailable and Settings keeps Current points editable.</p>
    <h3>Armor &amp; defenses</h3>
    <p>Armor: {{worn.type}} · worn AR {{worn.armorAR}} + shield AR {{worn.shieldAR}} · light armor Evasion +{{worn.evasion}}. Effective AGL {{worn.effectiveAgility}}, armor penalty {{worn.agilityPenalty}}. A square costs {{worn.squareCost}} ft, or {{worn.difficultSquareCost}} ft in difficult terrain.</p>
    <p>Block uses {{block.formula}} {{block.strMod}} STR; another die at level {{block.nextLevel}}. Use arm guards, a weapon or a shield. Dodge uses AGL; Parry uses DEX and normally needs DEX 21 plus held equipment. Each dialog has its own rules section. Apply Health changes manually.</p>
  </details>
  </section>
  <section class="tab wb-sheet-panel {{tabs.equipment.cssClass}}" data-group="sheet" data-tab="equipment" data-record-tab aria-label="Equipment">
  <section class="wb-equipment" aria-label="Equipment">
    <div class="wb-section-heading wb-record-heading"><div><span class="wb-eyebrow">Arsenal &amp; possessions</span><h2 class="wb-section-title">Equipment</h2></div>
    <details class="wb-add-equipment" data-sync="add-equipment"><summary>Add item</summary><div class="wb-equipment-actions">
      <button type="button" data-action="equipment" data-operation="create" data-type="weapon" {{#unless editable}}disabled{{/unless}}>Add weapon</button>
      <button type="button" data-action="equipment" data-operation="create" data-type="armor" {{#unless editable}}disabled{{/unless}}>Add armor</button>
      <button type="button" data-action="equipment" data-operation="create" data-type="shield" {{#unless editable}}disabled{{/unless}}>Add shield</button>
      <button type="button" data-action="equipment" data-operation="create" data-type="consumable" {{#unless editable}}disabled{{/unless}}>Add consumable</button>
      <button type="button" data-action="equipment" data-operation="create" data-type="misc" {{#unless editable}}disabled{{/unless}}>Add miscellaneous</button>
    </div></details></div>
    <div class="wb-inventory">
      <p class="wb-inventory-total {{#if carrying.over}}is-over{{/if}}"><strong>{{carrying.used}} / {{carrying.capacity}}</strong> inventory slots{{#if carrying.over}} · over by {{carrying.over}}{{/if}}</p>
      <label class="wb-equipment-check"><input type="checkbox" name="system.inventory.backpack" {{#if system.inventory.backpack}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> Backpack</label>
      <span class="wb-inventory-meter {{#if carrying.over}}is-over{{/if}}" style="--wb-load:{{carrying.used}};--wb-capacity:{{carrying.capacity}}" aria-hidden="true"><span></span></span>
    </div>
    {{#each equipmentGroups}}
    <section class="wb-equipment-group">
      <h3 class="wb-equipment-group-title">{{label}} <span>{{rows.length}}</span></h3>
      <ul class="wb-equipment-list">
        {{#each rows}}
        <li class="wb-equipment-row {{#if equipped}}is-equipped{{/if}}" data-item-id="{{id}}">
          <img class="wb-item-icon" src="{{img}}" alt="" loading="lazy">
          <div class="wb-item-main">
            <button type="button" class="wb-equipment-name" data-action="equipment" data-operation="edit" data-tooltip="{{detail}}{{#if bonusHint}} · {{bonusHintTitle}}: {{bonusHint}}{{/if}}{{#if bonusDuration}} · {{bonusDuration}}{{/if}} · Qty {{quantity}} · {{slots}} slots">
              <span class="wb-item-title">{{name}} {{#if showQuantity}}<span class="wb-quantity" aria-label="Quantity {{quantity}}">×{{quantity}}</span>{{/if}}</span>
              <span class="wb-item-brief">{{#if brief}}{{brief}}{{else}}{{typeLabel}}{{/if}}{{#if bonusHint}} · <span class="wb-bonus-hint" title="{{bonusHintTitle}}">{{bonusHint}}</span>{{/if}}{{#if bonusDuration}} · {{bonusDuration}}{{/if}}</span>
            </button>
          </div>
          <div class="wb-row-actions">
            {{#if canAttack}}<button type="button" class="wb-row-attack" data-action="equipment" data-operation="attack" aria-label="Attack with {{name}}" data-tooltip="Attack" {{#unless @root.editable}}disabled{{/unless}}><i class="fa-solid fa-crosshairs" aria-hidden="true"></i><span>Attack</span></button>{{/if}}
            {{#if canReload}}<button type="button" data-action="equipment" data-operation="reload" aria-label="Reload {{name}}" data-tooltip="Reload" {{#unless @root.editable}}disabled{{/unless}}><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button>{{/if}}
            {{#if canUse}}<button type="button" class="wb-row-use" data-action="equipment" data-operation="use" aria-label="Use one {{name}}" data-tooltip="Use one" {{#unless @root.editable}}disabled{{/unless}}><i class="fa-solid fa-flask" aria-hidden="true"></i><span>Use</span></button>{{/if}}
            {{#if canEquip}}<button type="button" class="wb-equip-toggle" data-action="equipment" data-operation="toggle" aria-pressed="{{equipped}}" aria-label="{{#if equipped}}Unequip{{else}}Equip{{/if}} {{name}}" data-tooltip="{{#if equipped}}Equipped · click to unequip{{else}}Equip{{/if}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fa-solid {{equipIcon}}" aria-hidden="true"></i></button>{{/if}}
            <button type="button" class="wb-item-remove" data-action="equipment" data-operation="delete" aria-label="Remove {{name}}" data-tooltip="Remove" {{#unless @root.editable}}disabled{{/unless}}><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
          </div>
        </li>
        {{/each}}
      </ul>
    </section>
    {{else}}<p class="wb-empty">Drop an item here or choose Add item.</p>{{/each}}
  </section>
  <details class="wb-disclosure wb-help" data-sync="equipment-help"><summary>Equipment help</summary>
    <h3>Equipment</h3>
    <p>Drop items from Foundry's Items directory or use Add item. Equip a weapon to attack. Worn armor and held weapons/shields take no slots; capacity is 10 + STR modifier, with +6 for a backpack. A leg-guard item represents a complete pair. Review old manual armor totals after equipping armor to avoid counting it twice.</p>
  </details>
  </section>
  <section class="tab wb-sheet-panel {{tabs.abilities.cssClass}}" data-group="sheet" data-tab="abilities" data-record-tab aria-label="Abilities and forms">
  <section class="wb-abilities wb-equipment" aria-label="Abilities">
    <div class="wb-section-heading wb-record-heading"><div><span class="wb-eyebrow">Inscribed arts &amp; transformations</span><h2 class="wb-section-title">Abilities</h2></div>
      <div class="wb-equipment-actions">
        {{#if hasForms}}<button type="button" data-action="ability" data-operation="base" aria-pressed="{{#unless hasActiveForm}}true{{else}}false{{/unless}}" {{#unless editable}}disabled{{/unless}}>{{baseFormName}}</button>{{/if}}
        <button type="button" data-action="archiveAppearance" title="Rename your base form, for example Human Form" {{#unless editable}}disabled{{/unless}}><i class="fa-solid fa-pen" aria-hidden="true"></i> Rename base form</button>
        {{#if hasHiddenFormAbilities}}<button type="button" data-action="formView" data-view="abilities" aria-pressed="{{showAllFormAbilities}}">{{#if showAllFormAbilities}}Form abilities{{else}}Show all{{/if}}</button>{{/if}}
        <button type="button" data-action="ability" data-operation="create" {{#unless editable}}disabled{{/unless}}>Add ability</button>
        <button type="button" data-action="ability" data-operation="create" data-kind="form" {{#unless editable}}disabled{{/unless}}>Add form</button>
      </div>
    </div>
    {{#each abilityGroups}}
    <section class="wb-equipment-group"><h3 class="wb-equipment-group-title">{{label}} <span>{{rows.length}}</span></h3>
      <ul class="wb-equipment-list">
        {{#each rows}}
        <li class="wb-equipment-row {{#if effectsActive}}is-active{{/if}}" data-ability-id="{{id}}" {{#if legacy}}data-effect-uuid="{{uuid}}"{{/if}}>
          <img class="wb-item-icon" src="{{img}}" alt="" loading="lazy">
          <div class="wb-item-main"><button type="button" class="wb-equipment-name" data-action="{{#if legacy}}savedAbility{{else}}ability{{/if}}" data-operation="edit" aria-label="Open {{name}}: {{summary}}" data-tooltip="{{summary}}">
            <span class="wb-item-title">{{name}} {{#if category}}<span class="wb-quantity">{{category}}</span>{{/if}}</span>
            <span class="wb-item-brief">{{summary}}</span>
            {{#if timerSummary}}<span class="wb-status-time">{{timerSummary}}</span>{{/if}}
          </button></div>
          <div class="wb-row-actions">{{#if canUse}}<button type="button" class="wb-row-use" data-action="{{#if legacy}}savedAbility{{else}}ability{{/if}}" data-operation="{{#if effectsActive}}end{{else}}use{{/if}}" {{#unless @root.editable}}disabled{{/unless}}>{{#if effectsActive}}End{{else}}Use{{/if}}</button>{{/if}}<button type="button" class="wb-item-remove" data-action="{{#if legacy}}savedAbility{{else}}ability{{/if}}" data-operation="delete" aria-label="Remove {{name}}" data-tooltip="Remove" {{#unless @root.editable}}disabled{{/unless}}><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button></div>
          {{#if hasDetails}}<details class="wb-disclosure wb-ability-details" data-sync="ability-{{id}}"><summary>Details</summary>
            {{#if description}}<p class="wb-ability-text">{{description}}</p>{{/if}}
            {{#if duration}}<p>Duration: {{duration}}</p>{{/if}}{{#if recovery}}<p>Uses recover: {{recovery}}</p>{{/if}}
            {{#if notes}}<p class="wb-ability-text">{{notes}}</p>{{/if}}
          </details>{{/if}}
        </li>
        {{/each}}
      </ul>
    </section>
    {{else}}<p class="wb-empty">Add an ability or drop one from the Items directory.</p>{{/each}}
  </section>

  </section>
  <section class="tab wb-sheet-panel {{tabs.status.cssClass}}" data-group="sheet" data-tab="status" data-record-tab aria-label="Status">
  <section class="wb-status wb-equipment" aria-label="Active status">
    <header class="wb-record-heading"><div><span class="wb-eyebrow">Active influences</span><h2 class="wb-section-title">Status <span class="wb-record-count">{{overviewStatusCount}}</span></h2></div><span class="wb-record-seal" aria-hidden="true"><i class="fa-solid fa-circle-nodes"></i></span></header>
    <ul class="wb-equipment-list">
      {{#each activeStatuses}}<li class="wb-equipment-row" data-effect-uuid="{{uuid}}">
        <img class="wb-item-icon" src="{{img}}" alt="" loading="lazy">
        <div class="wb-item-main"><button type="button" class="wb-equipment-name" data-action="status" data-operation="edit" aria-label="Open source: {{name}}" data-tooltip="{{summary}}{{#if source}} · {{source}}{{/if}}">
          <span class="wb-item-title">{{name}}</span>
          <span class="wb-item-brief">{{#if source}}{{source}} · {{/if}}{{summary}}</span>
          {{#if timeLeft}}<span class="wb-status-time">{{timeLeft}}</span>{{/if}}
        </button></div>
        {{#if canEnd}}<div class="wb-row-actions"><button type="button" class="wb-row-use" data-action="status" data-operation="end" aria-label="End {{name}}" {{#unless @root.editable}}disabled{{/unless}}>End</button></div>{{/if}}
      </li>{{else}}<li class="wb-empty">Nothing is actively affecting you.</li>{{/each}}
    </ul>
  </section>

  </section>
  <section class="tab wb-sheet-panel {{tabs.notes.cssClass}}" data-group="sheet" data-tab="notes" data-record-tab aria-label="Notes">
  <section class="wb-character-details" aria-label="Character details and notes">
    <header class="wb-record-heading"><div><span class="wb-eyebrow">The personal chronicle</span><h2 class="wb-section-title">Character details &amp; notes</h2></div><span class="wb-record-seal" aria-hidden="true"><i class="fa-solid fa-feather-pointed"></i></span></header>
    <div class="wb-character-details-grid">
      {{#each characterDetails}}
      <div class="wb-character-detail {{#if wide}}wb-character-detail-wide{{/if}}">
        {{#if @root.editable}}
        <label><span class="wb-eyebrow">{{label}}</span>
          {{#if rows}}<textarea name="system.details.{{key}}" rows="{{rows}}" placeholder="{{placeholder}}">{{value}}</textarea>
          {{else}}<input type="text" name="system.details.{{key}}" value="{{value}}" placeholder="{{placeholder}}">{{/if}}
        </label>
        {{else}}
        <h3 class="wb-eyebrow">{{label}}</h3>
        {{#if value}}<div class="wb-character-detail-text">{{value}}</div>{{else}}<p class="wb-empty">Not entered</p>{{/if}}
        {{/if}}
      </div>
      {{/each}}
    </div>
  </section>
  </section>
</div>
