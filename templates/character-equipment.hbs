  <section
    class="tab wb-sheet-panel {{tabs.equipment.cssClass}}"
    data-group="sheet"
    data-tab="equipment"
    data-record-tab
    aria-label="Equipment"
  >
  <section class="wb-equipment" aria-label="Equipment">
    <div class="wb-section-heading wb-record-heading"><div><span class="wb-eyebrow">Arsenal &amp; possessions</span><h2 class="wb-section-title">Equipment</h2></div>
    <details class="wb-add-equipment" data-sync="add-equipment"><summary>Add item</summary><div class="wb-equipment-actions">
      <button type="button" data-action="equipment" data-operation="create" data-type="weapon" {{#unless editable}}disabled{{/unless}}>Add weapon</button>
      <button type="button" data-action="equipment" data-operation="create" data-type="armor" {{#unless editable}}disabled{{/unless}}>Add armor</button>
      <button type="button" data-action="equipment" data-operation="create" data-type="shield" {{#unless editable}}disabled{{/unless}}>Add shield</button>
      <button type="button" data-action="equipment" data-operation="create" data-type="accessory" {{#unless editable}}disabled{{/unless}}>Add accessory</button>
      <button type="button" data-action="equipment" data-operation="create" data-type="consumable" {{#unless editable}}disabled{{/unless}}>Add consumable</button>
      <button type="button" data-action="equipment" data-operation="create" data-type="misc" {{#unless editable}}disabled{{/unless}}>Add miscellaneous</button>
    </div></details></div>
    <details class="wb-disclosure wb-doll-panel" data-sync="armor-layout" open><summary>Worn equipment</summary>
      <div class="wb-doll-layout">
        <div class="wb-doll">
          <svg class="wb-doll-figure" viewBox="0 0 400 500" aria-hidden="true" focusable="false">
            <ellipse class="wb-doll-plinth" cx="200" cy="474" rx="70" ry="6"/>
            <path class="wb-doll-part {{#if doll.worn.arms}}is-worn{{/if}}" d="M147 136 C135 138 128 148 127 164 L123 232 L119 306 C118 320 139 322 140 308 L145 234 L153 176 Z"/>
            <path class="wb-doll-part {{#if doll.worn.arms}}is-worn{{/if}}" d="M253 136 C265 138 272 148 273 164 L277 232 L281 306 C282 320 261 322 260 308 L255 234 L247 176 Z"/>
            <path class="wb-doll-part {{#if doll.worn.pants}}is-worn{{/if}}" d="M170 278 L198 278 L196 364 L166 364 Z"/>
            <path class="wb-doll-part {{#if doll.worn.pants}}is-worn{{/if}}" d="M230 278 L202 278 L204 364 L234 364 Z"/>
            <path class="wb-doll-part {{#if doll.worn.legs}}is-worn{{/if}}" d="M166 364 L196 364 L191 444 L195 466 L161 466 L165 444 Z"/>
            <path class="wb-doll-part {{#if doll.worn.legs}}is-worn{{/if}}" d="M204 364 L234 364 L235 444 L239 466 L205 466 L209 444 Z"/>
            <path class="wb-doll-body" d="M190 104 V126 H210 V104 Z"/>
            <path class="wb-doll-part {{#if doll.worn.chest}}is-worn{{/if}}" d="M150 132 C170 120 230 120 250 132 L243 202 L231 276 L169 276 L157 202 Z"/>
            <path class="wb-doll-seam" d="M200 132 V246"/>
            <ellipse class="wb-doll-part {{#if doll.worn.helmet}}is-worn{{/if}}" cx="200" cy="78" rx="25" ry="29"/>
            <path class="wb-doll-part wb-doll-acc {{#if doll.worn.strapped}}is-worn{{/if}}" d="M256 246 L278 244 L280 280 L258 282 Z"/>
            <path class="wb-doll-part wb-doll-acc wb-doll-chain {{#if doll.worn.amulet}}is-worn{{/if}}" d="M190 124 L200 146 L210 124"/>
            <path class="wb-doll-part wb-doll-acc wb-doll-gem {{#if doll.worn.amulet}}is-worn{{/if}}" d="M200 145 L206 152 L200 161 L194 152 Z"/>
            <path class="wb-doll-part wb-doll-acc {{#if doll.worn.belt}}is-worn{{/if}}" d="M165 248 H235 L233 264 H167 Z"/>
            <rect class="wb-doll-part wb-doll-acc wb-doll-gem {{#if doll.worn.belt}}is-worn{{/if}}" x="195" y="246" width="10" height="20" rx="2"/>
            <circle class="wb-doll-part wb-doll-acc wb-doll-gem {{#if doll.worn.ringRight}}is-worn{{/if}}" cx="129" cy="304" r="5.5"/>
            <circle class="wb-doll-part wb-doll-acc wb-doll-gem {{#if doll.worn.ringLeft}}is-worn{{/if}}" cx="271" cy="304" r="5.5"/>
            <path class="wb-doll-lead {{#if doll.worn.helmet}}is-worn{{/if}}" d="M112 53 H150 L177 71"/>
            <path class="wb-doll-lead {{#if doll.worn.amulet}}is-worn{{/if}}" d="M288 53 H262 L208 150"/>
            <path class="wb-doll-lead {{#if doll.worn.arms}}is-worn{{/if}}" d="M112 151 H124 L137 176"/>
            <path class="wb-doll-lead {{#if doll.worn.strapped}}is-worn{{/if}}" d="M288 151 H282 L270 244"/>
            <path class="wb-doll-lead {{#if doll.worn.chest}}is-worn{{/if}}" d="M112 249 H155 L181 213"/>
            <path class="wb-doll-lead {{#if doll.worn.belt}}is-worn{{/if}}" d="M288 249 H245 L234 256"/>
            <path class="wb-doll-lead {{#if doll.worn.ringRight}}is-worn{{/if}}" d="M112 347 H118 L126 309"/>
            <path class="wb-doll-lead {{#if doll.worn.ringLeft}}is-worn{{/if}}" d="M288 347 H282 L274 309"/>
            <path class="wb-doll-lead {{#if doll.worn.pants}}is-worn{{/if}}" d="M112 445 H150 L176 352"/>
            <path class="wb-doll-lead {{#if doll.worn.legs}}is-worn{{/if}}" d="M288 445 H250 L223 427"/>
            <circle class="wb-doll-anchor {{#if doll.worn.helmet}}is-worn{{/if}}" cx="179" cy="72" r="3.5"/>
            <circle class="wb-doll-anchor {{#if doll.worn.arms}}is-worn{{/if}}" cx="139" cy="178" r="3.5"/>
            <circle class="wb-doll-anchor {{#if doll.worn.strapped}}is-worn{{/if}}" cx="269" cy="247" r="3.5"/>
            <circle class="wb-doll-anchor {{#if doll.worn.chest}}is-worn{{/if}}" cx="183" cy="211" r="3.5"/>
            <circle class="wb-doll-anchor {{#if doll.worn.pants}}is-worn{{/if}}" cx="177" cy="349" r="3.5"/>
            <circle class="wb-doll-anchor {{#if doll.worn.legs}}is-worn{{/if}}" cx="221" cy="426" r="3.5"/>
          </svg>
          {{#each doll.slots}}<div
            class="wb-doll-slot wb-doll-{{side}} wb-doll-row-{{row}} {{#if filled}}is-filled{{/if}}"
            {{#if itemId}}data-item-id="{{itemId}}"{{/if}}
          ><button
            type="button"
            class="wb-doll-slot-main"
            data-action="bodySlot"
            data-slot="{{key}}"
            aria-label="{{label}}: {{name}}. Choose what to wear"
            data-tooltip="{{label}}: {{name}}{{#if detail}} · {{detail}}{{/if}}"
            {{#unless @root.editable}}disabled{{/unless}}
          ><span class="wb-doll-slot-label">{{label}}</span><span class="wb-doll-slot-body">{{#if img}}<img
            src="{{img}}"
            alt=""
            loading="lazy"
          >{{/if}}<span class="wb-doll-slot-text"><span class="wb-doll-slot-name">{{name}}</span>{{#if detail}}<span
            class="wb-doll-slot-detail"
          >{{detail}}</span>{{/if}}</span></span></button>{{#if filled}}<button
            type="button"
            class="wb-doll-slot-clear"
            data-action="bodySlot"
            data-operation="clear"
            data-slot="{{key}}"
            aria-label="Take off {{name}}"
            data-tooltip="Take off"
            {{#unless @root.editable}}disabled{{/unless}}
          ><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>{{/if}}</div>{{/each}}
        </div>
        <aside class="wb-doll-side" aria-label="Armor and hands">
          <div class="wb-doll-total">
            <span class="wb-eyebrow">Armor Rating</span>
            <strong>{{doll.armorRating}}</strong>
            {{#if doll.armorParts}}<span class="wb-doll-total-parts">{{doll.armorParts}}</span>{{/if}}
            <ul class="wb-doll-notes">{{#each doll.armorNotes}}<li>{{this}}</li>{{/each}}</ul>
          </div>
          <h3 class="wb-doll-heading">Hands</h3>
          <div class="wb-doll-hands">{{#each doll.hands}}<div
            class="wb-doll-hand {{#if filled}}is-filled{{/if}} {{#if covered}}is-covered{{/if}}"
            {{#if itemId}}data-item-id="{{itemId}}"{{/if}}
          ><button
            type="button"
            class="wb-doll-slot-main"
            data-action="bodySlot"
            data-slot="{{key}}"
            aria-label="{{label}}: {{#if covered}}{{coverText}}{{else}}{{name}}{{/if}}. Choose what to hold"
            {{#unless @root.editable}}disabled{{/unless}}
          ><span class="wb-doll-slot-label">{{label}}</span><span class="wb-doll-slot-body">{{#if img}}<img
            src="{{img}}"
            alt=""
            loading="lazy"
          >{{/if}}<span class="wb-doll-slot-text"><span class="wb-doll-slot-name">{{#if covered}}{{coverText}}{{else}}{{name}}{{/if}}</span>{{#if detail}}<span
            class="wb-doll-slot-detail"
          >{{detail}}</span>{{/if}}</span></span></button>{{#if canAttack}}<button
            type="button"
            class="wb-doll-hand-attack"
            data-action="equipment"
            data-operation="attack"
            aria-label="Attack with {{name}}"
            data-tooltip="Attack"
            {{#unless @root.editable}}disabled{{/unless}}
          ><i class="fa-solid fa-crosshairs" aria-hidden="true"></i></button>{{/if}}{{#if filled}}<button
            type="button"
            class="wb-doll-slot-clear"
            data-action="bodySlot"
            data-operation="clear"
            data-slot="{{key}}"
            aria-label="Stow {{name}}"
            data-tooltip="Stow"
            {{#unless @root.editable}}disabled{{/unless}}
          ><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>{{/if}}</div>{{/each}}</div>
          {{#if doll.extraHeld}}<p class="wb-doll-warning">Also equipped: {{doll.extraHeld}}. Stow or re-equip to fix your hands.</p>{{/if}}
          <p class="wb-doll-hint">Select a slot to wear or hold something you're carrying. Strapped weapons sit on the forearm and leave both hands free.</p>
        </aside>
      </div>
    </details>
    <div class="wb-inventory">
      <p class="wb-inventory-total {{#if carrying.over}}is-over{{/if}}"><strong>{{carrying.used}} / {{carrying.capacity}}</strong> inventory slots{{#if carrying.over}} · over by {{carrying.over}}{{/if}}</p>
      <label class="wb-equipment-check"><input
        type="checkbox"
        name="system.inventory.backpack"
        {{#if system.inventory.backpack}}checked{{/if}}
        {{#unless editable}}disabled{{/unless}}
      > Backpack</label>
      <span
        class="wb-inventory-meter {{#if carrying.over}}is-over{{/if}}"
        style="--wb-load:{{carrying.used}};--wb-capacity:{{carrying.capacity}}"
        aria-hidden="true"
      ><span></span></span>
    </div>
    <section class="wb-currency" aria-label="Currency">
      <h3 class="wb-eyebrow"><i class="fa-solid fa-coins" aria-hidden="true"></i> Currency</h3>
      <label><span class="wb-eyebrow">Gold coins (gc)</span>
        <input
          type="number"
          name="system.currency.gc"
          value="{{currency.gc}}"
          min="0"
          step="1"
          aria-label="Gold coins (gc)"
          {{#unless editable}}disabled{{/unless}}
        >
      </label>
      <label><span class="wb-eyebrow">Platinum coins (pc)</span>
        <input
          type="number"
          name="system.currency.pc"
          value="{{currency.pc}}"
          min="0"
          step="1"
          aria-label="Platinum coins (pc)"
          {{#unless editable}}disabled{{/unless}}
        >
      </label>
      <p class="wb-currency-summary"><span>Total <strong>{{currency.total}} gc</strong></span><span>1 pc = {{currency.goldPerPlatinum}} gc</span></p>
    </section>
    {{#each equipmentGroups}}
    <section class="wb-equipment-group">
      <h3 class="wb-equipment-group-title">{{label}} <span>{{rows.length}}</span></h3>
      <ul class="wb-equipment-list">
        {{#each rows}}
        <li class="wb-equipment-row {{#if equipped}}is-equipped{{/if}}" data-item-id="{{id}}">
          <img class="wb-item-icon" src="{{img}}" alt="" loading="lazy">
          <div class="wb-item-main">
            <button
              type="button"
              class="wb-equipment-name"
              data-action="equipment"
              data-operation="edit"
              data-tooltip="{{detail}}{{#if bonusHint}} · {{bonusHintTitle}}: {{bonusHint}}{{/if}}{{#if bonusDuration}} · {{bonusDuration}}{{/if}} · Qty {{quantity}} · {{slots}} slots"
            >
              <span class="wb-item-title">{{name}} {{#if showQuantity}}<span class="wb-quantity" aria-label="Quantity {{quantity}}">×{{quantity}}</span>{{/if}}</span>
              <span class="wb-item-brief">{{#if brief}}{{brief}}{{else}}{{typeLabel}}{{/if}}{{#if bonusHint}} · <span
                class="wb-bonus-hint"
                title="{{bonusHintTitle}}"
              >{{bonusHint}}</span>{{/if}}{{#if bonusDuration}} · {{bonusDuration}}{{/if}}</span>
            </button>
          </div>
          <div class="wb-row-actions">
            {{#if canAttack}}<button
              type="button"
              class="wb-row-attack"
              data-action="equipment"
              data-operation="attack"
              aria-label="Attack with {{name}}"
              data-tooltip="Attack"
              {{#unless @root.editable}}disabled{{/unless}}
            ><i
              class="fa-solid fa-crosshairs"
              aria-hidden="true"
            ></i><span>Attack</span></button>{{/if}}
            {{#if canReload}}<button
              type="button"
              data-action="equipment"
              data-operation="reload"
              aria-label="Reload {{name}}"
              data-tooltip="Reload"
              {{#unless @root.editable}}disabled{{/unless}}
            ><i
              class="fa-solid fa-rotate-right"
              aria-hidden="true"
            ></i></button>{{/if}}
            {{#if canUse}}<button
              type="button"
              class="wb-row-use"
              data-action="equipment"
              data-operation="use"
              aria-label="Use one {{name}}"
              data-tooltip="Use one"
              {{#unless @root.editable}}disabled{{/unless}}
            ><i
              class="fa-solid fa-flask"
              aria-hidden="true"
            ></i><span>Use</span></button>{{/if}}
            {{#if canEquip}}<button
              type="button"
              class="wb-equip-toggle"
              data-action="equipment"
              data-operation="toggle"
              aria-pressed="{{equipped}}"
              aria-label="{{#if equipped}}Unequip{{else}}Equip{{/if}} {{name}}"
              data-tooltip="{{#if equipped}}Equipped · click to unequip{{else}}Equip{{/if}} · In combat: 2 AP adjusted by DEX; Quickdraw is free"
              {{#unless @root.editable}}disabled{{/unless}}
            ><i
              class="fa-solid {{equipIcon}}"
              aria-hidden="true"
            ></i></button>{{/if}}
            <button
              type="button"
              class="wb-item-remove"
              data-action="equipment"
              data-operation="delete"
              aria-label="Remove {{name}}"
              data-tooltip="Remove"
              {{#unless @root.editable}}disabled{{/unless}}
            ><i
              class="fa-solid fa-trash-can"
              aria-hidden="true"
            ></i></button>
          </div>
        </li>
        {{/each}}
      </ul>
    </section>
    {{else}}<p class="wb-empty">Drop an item here or choose Add item.</p>{{/each}}
  </section>
  <details class="wb-disclosure wb-help" data-sync="equipment-help"><summary>Equipment help</summary>
    <p>Equip or stow weapons, shields and armor for 2 AP adjusted by DEX (1–3 AP) during combat. Swapping automatically stows conflicting hand gear for that single cost. Quickdraw weapons are free to draw, stow or swap to. Outside combat these actions are free. Direct Equipped edits on an item remain manual corrections; form presets keep their ability's recorded cost.</p>
    <h3>Equipment</h3>
    <p>Drop items from Foundry's Items directory or use Add item. Equip a weapon to attack. Worn armor and held weapons/shields take no slots; capacity is 10 + STR modifier, with +6 for a backpack. A leg-guard item represents a complete pair. Accessories are amulets, rings and belts: wear one amulet, one belt and two rings, and give them bonuses like any other gear. Review old manual armor totals after equipping armor to avoid counting it twice.</p>
  </details>
  </section>
