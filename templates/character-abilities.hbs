  <section
    class="tab wb-sheet-panel {{tabs.abilities.cssClass}}"
    data-group="sheet"
    data-tab="abilities"
    data-record-tab
    aria-label="Abilities and forms"
  >
  <section class="wb-abilities wb-equipment" aria-label="Abilities">
    <div class="wb-section-heading wb-record-heading"><div><span class="wb-eyebrow">Inscribed arts &amp; transformations</span><h2 class="wb-section-title">Abilities</h2></div>
      <div class="wb-equipment-actions">
        {{#if hasForms}}<button
          type="button"
          data-action="ability"
          data-operation="base"
          aria-pressed="{{#unless hasActiveForm}}true{{else}}false{{/unless}}"
          {{#unless editable}}disabled{{/unless}}
        >{{baseFormName}}</button>{{/if}}
        <button
          type="button"
          data-action="archiveAppearance"
          title="Rename your base form, for example Human Form"
          {{#unless editable}}disabled{{/unless}}
        ><i
          class="fa-solid fa-pen"
          aria-hidden="true"
        ></i> Rename base form</button>
        {{#if hasHiddenFormAbilities}}<button
          type="button"
          data-action="formView"
          data-view="abilities"
          aria-pressed="{{showAllFormAbilities}}"
        >{{#if showAllFormAbilities}}Form abilities{{else}}Show all{{/if}}</button>{{/if}}
        <button type="button" data-action="ability" data-operation="create" {{#unless editable}}disabled{{/unless}}>Add ability</button>
        <button type="button" data-action="ability" data-operation="spell" {{#unless editable}}disabled{{/unless}}>Add spell</button>
        <button type="button" data-action="ability" data-operation="create" data-kind="form" {{#unless editable}}disabled{{/unless}}>Add form</button>
      </div>
    </div>
    {{#each abilityGroups}}
    <section class="wb-equipment-group"><h3 class="wb-equipment-group-title">{{label}} <span>{{rows.length}}</span></h3>
      <ul class="wb-equipment-list">
        {{#each rows}}
        <li
          class="wb-equipment-row {{#if effectsActive}}is-active{{/if}}"
          data-ability-id="{{id}}"
          {{#if legacy}}data-effect-uuid="{{uuid}}"{{/if}}
        >
          <img class="wb-item-icon" src="{{img}}" alt="" loading="lazy">
          <div class="wb-item-main"><button
            type="button"
            class="wb-equipment-name"
            data-action="{{#if legacy}}savedAbility{{else}}ability{{/if}}"
            data-operation="edit"
            aria-label="Open {{name}}: {{summary}}"
            data-tooltip="{{summary}}"
          >
            <span class="wb-item-title">{{name}} {{#if category}}<span class="wb-quantity">{{category}}</span>{{/if}}</span>
            <span class="wb-item-brief">{{summary}}</span>
            {{#if timerSummary}}<span class="wb-status-time">{{timerSummary}}</span>{{/if}}
          </button></div>
          <div class="wb-row-actions">{{#if canUse}}<button
            type="button"
            class="wb-row-use"
            data-action="{{#if legacy}}savedAbility{{else}}ability{{/if}}"
            data-operation="{{#if effectsActive}}end{{else}}use{{/if}}"
            {{#unless @root.editable}}disabled{{/unless}}
          >{{#if effectsActive}}End{{else}}Use{{/if}}</button>{{/if}}<button
            type="button"
            class="wb-item-remove"
            data-action="{{#if legacy}}savedAbility{{else}}ability{{/if}}"
            data-operation="delete"
            aria-label="Remove {{name}}"
            data-tooltip="Remove"
            {{#unless @root.editable}}disabled{{/unless}}
          ><i
            class="fa-solid fa-trash-can"
            aria-hidden="true"
          ></i></button></div>
          {{#if hasDetails}}<details class="wb-disclosure wb-ability-details" data-sync="ability-{{id}}"><summary>Details</summary>
            {{#if description}}<p class="wb-ability-text">{{description}}</p>{{/if}}
            {{#if duration}}<p>Duration: {{duration}}</p>{{/if}}{{#if recovery}}<p>Uses recover: {{recovery}}</p>{{/if}}
            {{#if notes}}<p class="wb-ability-text">{{notes}}</p>{{/if}}
          </details>{{/if}}
        </li>
        {{/each}}
      </ul>
    </section>
    {{else}}<p class="wb-empty">Add an ability or drop one from the Items directory.</p>{{/each}}
    {{#if milestoneActions.length}}
    <section class="wb-equipment-group wb-milestone-actions" aria-label="Milestone actions"><h3 class="wb-equipment-group-title">Milestones <span>{{milestoneActions.length}}</span></h3>
      <ul class="wb-equipment-list">
        {{#each milestoneActions}}
        <li class="wb-equipment-row wb-milestone-action {{#unless ready}}is-spent{{/unless}}" data-milestone-action="{{id}}">
          <span class="wb-item-icon wb-milestone-icon" aria-hidden="true">◆</span>
          <div class="wb-item-main"><button
            type="button"
            class="wb-equipment-name"
            data-action="milestones"
            data-stat="{{stat}}"
            data-threshold="{{threshold}}"
            aria-label="Open the {{label}} rule"
            data-tooltip="{{text}}"
          >
            <span class="wb-item-title">{{label}} <span class="wb-quantity">{{statLabel}} {{threshold}}</span></span>
            <span class="wb-item-brief">{{usage}}{{#if attack}} · Declare in the attack dialog{{/if}}</span>
          </button></div>
          <div class="wb-row-actions"><label class="wb-milestone-uses" data-tooltip="Uses left. Change it to correct the tracker."><input
            type="number"
            min="0"
            max="{{maximum}}"
            step="1"
            value="{{remaining}}"
            data-milestone-uses="{{id}}"
            aria-label="{{label}} uses left"
            {{#unless @root.editable}}disabled{{/unless}}
          ><span>/ {{maximum}}</span></label>{{#if stabilize}}<button
            type="button"
            class="wb-row-use"
            data-action="milestoneAction"
            data-operation="stabilize"
            data-tooltip="Below 0 Health: d20 + VIT modifier against DC 12"
            {{#unless @root.editable}}disabled{{/unless}}
          >Stabilize</button>{{/if}}{{#unless attack}}<button
            type="button"
            class="wb-row-use"
            data-action="milestoneAction"
            data-operation="use"
            {{#unless ready}}disabled{{/unless}}
            {{#unless @root.editable}}disabled{{/unless}}
          >Use</button>{{/unless}}</div>
        </li>
        {{/each}}
      </ul>
    </section>
    {{/if}}
  </section>

  </section>
