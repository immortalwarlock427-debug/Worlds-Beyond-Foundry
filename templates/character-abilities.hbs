  <section class="tab wb-sheet-panel {{tabs.abilities.cssClass}}" data-group="sheet" data-tab="abilities" data-record-tab aria-label="Abilities and forms">
  <section class="wb-abilities wb-equipment" aria-label="Abilities">
    <div class="wb-section-heading wb-record-heading"><div><span class="wb-eyebrow">Inscribed arts &amp; transformations</span><h2 class="wb-section-title">Abilities</h2></div>
      <div class="wb-equipment-actions">
        {{#if hasForms}}<button type="button" data-action="ability" data-operation="base" aria-pressed="{{#unless hasActiveForm}}true{{else}}false{{/unless}}" {{#unless editable}}disabled{{/unless}}>{{baseFormName}}</button>{{/if}}
        <button type="button" data-action="archiveAppearance" title="Rename your base form, for example Human Form" {{#unless editable}}disabled{{/unless}}><i class="fa-solid fa-pen" aria-hidden="true"></i> Rename base form</button>
        {{#if hasHiddenFormAbilities}}<button type="button" data-action="formView" data-view="abilities" aria-pressed="{{showAllFormAbilities}}">{{#if showAllFormAbilities}}Form abilities{{else}}Show all{{/if}}</button>{{/if}}
        <button type="button" data-action="ability" data-operation="create" {{#unless editable}}disabled{{/unless}}>Add ability</button>
        <button type="button" data-action="ability" data-operation="create" data-kind="form" {{#unless editable}}disabled{{/unless}}>Add form</button>
      </div>
    </div>
    {{#each abilityGroups}}
    <section class="wb-equipment-group"><h3 class="wb-equipment-group-title">{{label}} <span>{{rows.length}}</span></h3>
      <ul class="wb-equipment-list">
        {{#each rows}}
        <li class="wb-equipment-row {{#if effectsActive}}is-active{{/if}}" data-ability-id="{{id}}" {{#if legacy}}data-effect-uuid="{{uuid}}"{{/if}}>
          <img class="wb-item-icon" src="{{img}}" alt="" loading="lazy">
          <div class="wb-item-main"><button type="button" class="wb-equipment-name" data-action="{{#if legacy}}savedAbility{{else}}ability{{/if}}" data-operation="edit" aria-label="Open {{name}}: {{summary}}" data-tooltip="{{summary}}">
            <span class="wb-item-title">{{name}} {{#if category}}<span class="wb-quantity">{{category}}</span>{{/if}}</span>
            <span class="wb-item-brief">{{summary}}</span>
            {{#if timerSummary}}<span class="wb-status-time">{{timerSummary}}</span>{{/if}}
          </button></div>
          <div class="wb-row-actions">{{#if canUse}}<button type="button" class="wb-row-use" data-action="{{#if legacy}}savedAbility{{else}}ability{{/if}}" data-operation="{{#if effectsActive}}end{{else}}use{{/if}}" {{#unless @root.editable}}disabled{{/unless}}>{{#if effectsActive}}End{{else}}Use{{/if}}</button>{{/if}}<button type="button" class="wb-item-remove" data-action="{{#if legacy}}savedAbility{{else}}ability{{/if}}" data-operation="delete" aria-label="Remove {{name}}" data-tooltip="Remove" {{#unless @root.editable}}disabled{{/unless}}><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button></div>
          {{#if hasDetails}}<details class="wb-disclosure wb-ability-details" data-sync="ability-{{id}}"><summary>Details</summary>
            {{#if description}}<p class="wb-ability-text">{{description}}</p>{{/if}}
            {{#if duration}}<p>Duration: {{duration}}</p>{{/if}}{{#if recovery}}<p>Uses recover: {{recovery}}</p>{{/if}}
            {{#if notes}}<p class="wb-ability-text">{{notes}}</p>{{/if}}
          </details>{{/if}}
        </li>
        {{/each}}
      </ul>
    </section>
    {{else}}<p class="wb-empty">Add an ability or drop one from the Items directory.</p>{{/each}}
  </section>

  </section>
