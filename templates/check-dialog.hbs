<div class="wb-check-options">
  <p class="wb-condition-reasons" {{#unless conditionText}}hidden{{/unless}}>{{conditionText}}</p>
  {{#if conditions.fear}}<label class="wb-check-toggle" data-tooltip="Defaults from linked sources and sight walls; change for darkness, senses or a ruling."><input type="checkbox" name="fearInSight" {{#if conditions.fearInSight}}checked{{/if}}> Fear source in sight</label>{{/if}}
  {{#if conditions.blind}}<label class="wb-check-toggle"><input type="checkbox" name="requiresSight"> This check requires sight (Blinded: fails)</label>{{/if}}
  {{#if conditions.deaf}}<label class="wb-check-toggle"><input type="checkbox" name="requiresHearing"> This check requires hearing (Deafened: fails)</label>{{/if}}
  {{#if exhaustion.checkDisadvantage}}<p class="wb-dialog-meta">Exhaustion: checks at disadvantage{{#if exhaustion.defenseDisadvantage}}; saves too{{/if}}. Dice remain editable.</p>{{/if}}
  {{#if heavyArmor}}<p class="wb-warning">Heavy armor · AGL saves have disadvantage.</p>{{/if}}
  <label><span>{{label}} roll</span>
    <select name="kind"><option value="check">Ability check</option><option value="save">Saving throw</option></select>
  </label>
  {{#if interactions.length}}<details class="wb-disclosure" data-wb-interaction>
    <summary>Interaction check</summary>
    <label class="wb-check-toggle"><input type="checkbox" name="interaction"> This is a roll to interact with the chosen creature</label>
    <label>Interacting with<select name="interactionTarget">
      <option value="">Choose a creature</option>
      {{#each interactions}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select></label>
  </details>{{/if}}
  <fieldset class="wb-dice-choices">
    <legend>Dice</legend>
    <label><input type="radio" name="mode" value="normal" {{#unless disadvantage}}checked{{/unless}}> Normal</label>
    <label data-tooltip="Roll two d20s; keep the higher"><input type="radio" name="mode" value="advantage"> Advantage</label>
    <label data-tooltip="Roll two d20s; keep the lower"><input type="radio" name="mode" value="disadvantage" {{#if disadvantage}}checked{{/if}}> Disadvantage</label>
  </fieldset>
  <details class="wb-disclosure wb-help"><summary>Roll help</summary><p>Normal rolls one d20. Advantage rolls two and keeps the higher; disadvantage keeps the lower. Your stat modifier is added. Use Wonder from the resulting chat card.</p></details>
</div>
