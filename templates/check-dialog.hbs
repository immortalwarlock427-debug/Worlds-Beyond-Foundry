<div class="wb-check-options">
  <label><span>{{label}} roll</span>
    <select name="kind"><option value="check">Ability check</option><option value="save">Saving throw</option></select>
  </label>
  <fieldset>
    <legend>Dice</legend>
    <label><input type="radio" name="mode" value="normal" checked> Normal · 1d20</label>
    <label><input type="radio" name="mode" value="advantage"> Advantage · keep the higher d20</label>
    <label><input type="radio" name="mode" value="disadvantage"> Disadvantage · keep the lower d20</label>
  </fieldset>
</div>
