  <section class="wb-resources" aria-label="Resources">
    {{#each resources as |resource|}}
    <div class="wb-resource wb-resource-{{resource.key}}">
      <label class="wb-resource-label">
        <span class="wb-eyebrow">{{resource.label}}</span>
        <span
          class="wb-resource-values"
          {{#if resource.sources}}data-tooltip="{{resource.sources}} · Final maximum overrides still take priority"{{/if}}
        >
          <input
            type="number"
            name="{{resource.inputName}}"
            value="{{resource.value}}"
            step="1"
            aria-label="Current {{resource.label}}"
            {{#unless @root.editable}}disabled{{/unless}}
          >
          <span class="wb-resource-max" aria-label="Maximum {{resource.label}}">/ {{resource.max}}</span>
        </span>
        {{#if resource.command}}<small
          class="wb-command-pool"
          data-tooltip="Already included in the total above. Command AP spends first on your turn; the maximum shown is your normal AP cap."
        >Includes {{resource.command}} Command AP{{#if resource.commandPending}} · your turn{{/if}}</small>{{/if}}
      </label>
    </div>
    {{/each}}
  </section>

  <div class="wb-wonder-rest">
    <button
      type="button"
      data-action="command"
      data-tooltip="Spend 5 own AP to give an ally up to 5 Command AP"
      {{#unless editable}}disabled{{/unless}}
    >Command</button>
    <button type="button" data-action="longRest" data-tooltip="Restore all resources to maximum" {{#unless editable}}disabled{{/unless}}>Long rest</button>
  </div>

  <details class="wb-disclosure wb-core-bar-colors" data-sync="core-bar-colors"><summary>Core bar colors</summary>
    <div class="wb-core-color-grid">{{#each resources}}<fieldset><legend>{{label}}</legend><div class="wb-bar-color-fields">
      <label>Color (hex)<input
        type="text"
        name="system.{{key}}.barColors.start"
        value="{{barColors.start}}"
        placeholder="Theme default"
        maxlength="7"
        pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})"
        title="Hex color such as #6FD6FF or #ABC. Clear for the default."
        autocomplete="off"
        spellcheck="false"
        {{#unless @root.editable}}disabled{{/unless}}
      ></label>
      <label>Gradient end (optional)<input
        type="text"
        name="system.{{key}}.barColors.end"
        value="{{barColors.end}}"
        placeholder="Solid color"
        maxlength="7"
        pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})"
        title="A second hex color blends left to right with the first."
        autocomplete="off"
        spellcheck="false"
        {{#unless @root.editable}}disabled{{/unless}}
      ></label>
    </div></fieldset>{{/each}}</div>
  </details>

  <section class="wb-extra-resources" aria-label="Magic and custom resources">
    <div class="wb-section-heading">
      <h2 class="wb-section-title">Resources</h2>
      {{#if hasHiddenFormResources}}<button
        type="button"
        data-action="formView"
        data-view="resources"
        aria-pressed="{{showAllFormResources}}"
      >{{#if showAllFormResources}}Form resources{{else}}Show all{{/if}}</button>{{/if}}
      <details class="wb-resource-management wb-disclosure" data-sync="resource-management"><summary>Manage</summary>
        <div class="wb-resource-management-fields">
          <label class="wb-equipment-check"><input
            type="checkbox"
            name="system.mana.enabled"
            {{#if manaEnabled}}checked{{/if}}
            {{#unless editable}}disabled{{/unless}}
          > Show mana</label>
          <label class="wb-equipment-check"><input
            type="checkbox"
            name="system.holyPower.enabled"
            {{#if holyPowerEnabled}}checked{{/if}}
            {{#unless editable}}disabled{{/unless}}
          > Show holy power</label>
          <button type="button" data-action="resource" data-operation="add" {{#unless editable}}disabled{{/unless}}>Add resource</button>
        </div>
      </details>
    </div>
    <div class="wb-extra-resource-grid">
      {{#each resourcePools}}
      <article class="wb-pool-card wb-pool-{{#if custom}}custom{{else}}{{key}}{{/if}}" data-resource-key="{{key}}">
        <header class="wb-pool-heading"><h3>{{label}}</h3>
          {{#if custom}}<button
            type="button"
            class="wb-item-remove"
            data-action="resource"
            data-operation="remove"
            aria-label="Remove {{label}}"
            data-tooltip="Remove resource"
            {{#unless @root.editable}}disabled{{/unless}}
          ><i
            class="fa-solid fa-trash-can"
            aria-hidden="true"
          ></i></button>{{/if}}
        </header>
        <div
          class="wb-resource-values {{#if percent}}wb-percent-values{{/if}}"
          data-tooltip="{{value}} / {{max}} points · Minimum {{min}}{{#if sources}} · {{sources}} · Final maximum overrides still take priority{{/if}}"
        >
          {{#if percentUnavailable}}<strong class="wb-percent-unavailable">—%</strong>
          {{else}}<input
            type="number"
            name="resourceValues.{{key}}"
            value="{{inputValue}}"
            step="1"
            aria-label="Current {{label}}{{#if percent}} percentage{{/if}}"
            {{#unless @root.editable}}disabled{{/unless}}
          ><span class="wb-resource-max">{{#if percent}}%{{else}}/ {{max}}{{/if}}</span>{{/if}}
        </div>
        <div
          class="wb-pool-meter"
          role="progressbar"
          aria-label="{{label}}"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="{{meterPercent}}"
          aria-valuetext="{{value}} points; minimum {{min}}, maximum {{max}}"
        ><span style="width: {{meterPercent}}%;{{barStyle}}"></span></div>
        <div class="wb-pool-actions">
          <input
            type="number"
            name="{{path}}.amount"
            value="{{amount}}"
            min="0"
            step="1"
            data-resource-amount
            aria-label="Points to spend or restore for {{label}}"
            data-tooltip="Points to spend or restore"
            {{#unless @root.editable}}disabled{{/unless}}
          >
          <button type="button" data-action="resource" data-operation="spend" {{#unless @root.editable}}disabled{{/unless}}>Spend</button>
          <button type="button" data-action="resource" data-operation="restore" {{#unless @root.editable}}disabled{{/unless}}>Restore</button>
          <button type="button" data-action="resource" data-operation="fill" {{#unless @root.editable}}disabled{{/unless}}>Fill</button>
        </div>
        {{#if regen}}<button
          type="button"
          class="wb-pool-recover"
          data-action="resource"
          data-operation="recover"
          data-tooltip="Apply this pool's configured recovery once"
          {{#unless @root.editable}}disabled{{/unless}}
        >Recover +{{regen}}</button>{{/if}}
        {{#if autoRecover}}{{#if regen}}<small class="wb-status-time">+{{regen}} on your turn</small>{{/if}}{{/if}}
        <details class="wb-disclosure wb-pool-settings" data-sync="pool-{{key}}"><summary>Settings</summary>
          <div class="wb-pool-settings-grid">
            {{#if custom}}
              <label>Name<input type="text" name="{{path}}.name" value="{{name}}" {{#unless @root.editable}}disabled{{/unless}}></label>
              <label data-tooltip="Selected stat × (level + 2)">Maximum from<select
                name="{{path}}.scaleStat"
                {{#unless @root.editable}}disabled{{/unless}}
              >{{#each scalingChoices}}<option
                value="{{value}}"
                {{#if selected}}selected{{/if}}
              >{{label}}</option>{{/each}}</select></label>
            {{/if}}
            <label>Recovery amount (points)<input
              type="number"
              name="{{path}}.regen"
              value="{{regen}}"
              min="0"
              step="1"
              {{#unless @root.editable}}disabled{{/unless}}
            ></label>
            <label
              class="wb-equipment-check"
              data-tooltip="Apply Recovery amount once at the start of this character's turn in a started encounter; the active GM performs it"
            ><input
              type="checkbox"
              name="{{path}}.autoRecover"
              {{#if autoRecover}}checked{{/if}}
              {{#unless @root.editable}}disabled{{/unless}}
            > Recover on own turn</label>
            <label class="wb-equipment-check"><input
              type="checkbox"
              name="{{path}}.refillOnRest"
              {{#if refillOnRest}}checked{{/if}}
              {{#unless @root.editable}}disabled{{/unless}}
            > Fill on long rest</label>
            <label data-tooltip="Replaces the calculated maximum and bonuses. Clear to restore the selected maximum source.">Maximum override<input
              type="number"
              name="{{path}}.maxOverride"
              value="{{maxOverride}}"
              placeholder="Default {{automatic}}"
              min="0"
              step="1"
              {{#unless @root.editable}}disabled{{/unless}}
            ></label>
            <label data-tooltip="Empty bar and spending floor. Clear to use 0; negative values are allowed.">Minimum override<input
              type="number"
              name="{{path}}.minOverride"
              value="{{minOverride}}"
              placeholder="Default 0"
              step="1"
              {{#unless @root.editable}}disabled{{/unless}}
            ></label>
            <label
              class="wb-equipment-check"
              data-tooltip="Restore and consumables can raise Current above the normal maximum. Fill still returns to the maximum."
            ><input
              type="checkbox"
              name="{{path}}.allowOverflow"
              {{#if allowOverflow}}checked{{/if}}
              {{#unless @root.editable}}disabled{{/unless}}
            > Allow over maximum</label>
            <label>Display<select name="{{path}}.display" {{#unless @root.editable}}disabled{{/unless}}>{{#each displayChoices}}<option
              value="{{value}}"
              {{#if selected}}selected{{/if}}
            >{{label}}</option>{{/each}}</select></label>
            <label>Color (hex)<input
              type="text"
              name="{{path}}.barColors.start"
              value="{{barColors.start}}"
              placeholder="Theme default"
              maxlength="7"
              pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})"
              title="Hex color such as #6FD6FF or #ABC. Clear for the default."
              autocomplete="off"
              spellcheck="false"
              {{#unless @root.editable}}disabled{{/unless}}
            ></label>
            <label>Gradient end (optional)<input
              type="text"
              name="{{path}}.barColors.end"
              value="{{barColors.end}}"
              placeholder="Solid color"
              maxlength="7"
              pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})"
              title="A second hex color blends left to right with the first."
              autocomplete="off"
              spellcheck="false"
              {{#unless @root.editable}}disabled{{/unless}}
            ></label>
            {{#if percentUnavailable}}<label data-tooltip="Percentage needs a maximum greater than minimum; edit points here">Current points<input
              type="number"
              name="resourceValues.{{key}}"
              value="{{value}}"
              step="1"
              {{#unless @root.editable}}disabled{{/unless}}
            ></label>{{/if}}
          </div>
        </details>
      </article>
      {{/each}}
    </div>
  </section>

